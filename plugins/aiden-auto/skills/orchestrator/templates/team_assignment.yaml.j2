# {{ project_name }} Multi-Session Stream Assignment
# Auto-generated by orchestrator skill (~/.claude/skills/orchestrator/)
# Template: templates/team_assignment.yaml.j2

version: 10.3.0
project_name: {{ project_name }}
project_root: {{ project_root }}
worktree_sibling_dir: {{ worktree_sibling_dir }}
orchestrator: {{ orchestrator_handle | default('conductor') }}

streams:
{%- for sid, s in streams.items() %}
  {{ sid }}:
    name: {{ s.name }}
    role: {{ s.role | default(s.name) }}
    worktree: {{ s.worktree }}
    absorbs_existing: {{ s.absorbs_existing | default([]) | tojson }}
    phases:
      {%- for pid, phase in s.phases.items() %}
      {{ pid }}:
        scope_owns:
          {%- for p in phase.scope_owns %}
          - "{{ p }}"
          {%- endfor %}
        {%- if phase.scope_read %}
        scope_read:
          {%- for p in phase.scope_read %}
          - "{{ p }}"
          {%- endfor %}
        {%- endif %}
        {%- if phase.blocked %}
        blocked:
          {%- for p in phase.blocked %}
          - "{{ p }}"
          {%- endfor %}
        {%- endif %}
      {%- endfor %}
    blocked_by: {{ s.blocked_by | default([]) | tojson }}
    blocks: {{ s.blocks | default([]) | tojson }}
    meta_files_blocked:
      - "CLAUDE.md"
      - "MEMORY.md"
      - "docs/orchestrator/team_assignment.yaml"
{%- endfor %}

{% if future_streams %}
future_streams:
{%- for sid, s in future_streams.items() %}
  {{ sid }}:
    name: {{ s.name }}
    worktree: {{ s.worktree }}
    absorbs_existing: {{ s.absorbs_existing | default([]) | tojson }}
    activation_trigger: "{{ s.activation_trigger | default('user request') }}"
    inferred_blocked_by: {{ s.inferred_blocked_by | default([]) | tojson }}
{%- endfor %}
{% endif %}

meta_files:
  owner: orchestrator
  files:
    - CLAUDE.md
    - MEMORY.md
    - docs/orchestrator/team_assignment.yaml

work_declaration_protocol:
  on_start:
    - "python tools/orchestrator/team_session_start.py --title='<제목>'"
  on_complete:
    - "python tools/orchestrator/team_session_end.py --message='<요약>'"

monitoring:
  command: "python tools/orchestrator/orchestrator_monitor.py --config=docs/orchestrator/team_assignment.yaml"
  interval_seconds: 30
